@model IEnumerable<DiarioDoCoelho.Models.ProdutoLoja>

@{
    ViewData["Title"] = "Produtos da Loja";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0 text-gray-800">Loja do Coelho (Produtos Afiliados)</h1>
    <a asp-action="Create" class="btn btn-primary shadow-sm">
        <i class="fas fa-plus fa-sm text-white-50"></i> Novo Produto
    </a>
</div>

<div class="card shadow mb-4">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered" width="100%" cellspacing="0">
                <thead>
                    <tr>
                        <th>Imagem</th>
                        <th>Nome</th>
                        <th>Loja</th>
                        <th>Status</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model) {
                        <tr>
                            <td class="align-middle text-center">
                                <img src="@item.ImagemUrl" alt="@item.Nome" style="width: 50px; height: 50px; object-fit: contain;" />
                            </td>
                            <td class="align-middle">
                                <strong>@item.Nome</strong>
                            </td>
                            <td class="align-middle">
                                @item.Loja
                            </td>
                            <td class="align-middle">
                                @if (item.Ativo)
                                {
                                    <span class="badge bg-success">Ativo</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inativo</span>
                                }
                            </td>
                            <td class="align-middle">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white">Editar</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Excluir</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
