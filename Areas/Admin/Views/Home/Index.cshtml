@model DiarioDoCoelho.ViewModels.AdminDashboardViewModel

@{
    ViewData["Title"] = "Painel";
}

<h1 class="mb-4">Painel Administrativo</h1>

@if (TempData["MensagemSucesso"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["MensagemSucesso"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["MensagemErro"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["MensagemErro"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <a asp-controller="Posts" asp-action="Index" class="text-decoration-none">
            <div class="card admin-dashboard-card">
                <div class="card-body">
                    <div class="admin-dashboard-icon bg-verde"><i class="fa-solid fa-newspaper"></i></div>
                    <div class="admin-dashboard-count">@Model.TotalPosts</div>
                    <div class="text-muted">Artigos</div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-6 col-lg-3">
        <a asp-controller="Categorias" asp-action="Index" class="text-decoration-none">
            <div class="card admin-dashboard-card">
                <div class="card-body">
                    <div class="admin-dashboard-icon bg-amarelo"><i class="fa-solid fa-tags"></i></div>
                    <div class="admin-dashboard-count">@Model.TotalCategorias</div>
                    <div class="text-muted">Categorias</div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-6 col-lg-3">
        <a asp-controller="ProdutosLoja" asp-action="Index" class="text-decoration-none">
            <div class="card admin-dashboard-card">
                <div class="card-body">
                    <div class="admin-dashboard-icon bg-vinho"><i class="fa-solid fa-store"></i></div>
                    <div class="admin-dashboard-count">@Model.TotalProdutos</div>
                    <div class="text-muted">Loja</div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-6 col-lg-3">
        <a asp-controller="BannersAfiliados" asp-action="Index" class="text-decoration-none">
            <div class="card admin-dashboard-card">
                <div class="card-body">
                    <div class="admin-dashboard-icon bg-vermelho"><i class="fa-solid fa-rectangle-ad"></i></div>
                    <div class="admin-dashboard-count">@Model.TotalBanners</div>
                    <div class="text-muted">Banners</div>
                </div>
            </div>
        </a>
    </div>
</div>

<div class="row g-4">
    <div class="col-12 col-lg-7">
        <div class="card admin-card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="card-title mb-0"><i class="fa-solid fa-newspaper text-coelho-verde"></i> Últimos Artigos</h5>
                    <a asp-controller="Posts" asp-action="Create" class="btn btn-coelho-primary btn-sm">
                        <i class="fa-solid fa-plus"></i> Novo Artigo
                    </a>
                </div>
                @if (Model.UltimosPosts.Any())
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var post in Model.UltimosPosts)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                <div>
                                    <strong>@post.Titulo</strong>
                                    <div class="text-muted small">@post.Categoria?.Nome — @post.DataPublicacao.ToString("dd/MM/yyyy")</div>
                                </div>
                                <a asp-controller="Posts" asp-action="Edit" asp-route-id="@post.Id" class="btn btn-sm btn-outline-secondary">
                                    <i class="fa-solid fa-pen"></i>
                                </a>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted">Nenhum artigo cadastrado ainda.</p>
                }
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-5">
        <div class="card admin-card">
            <div class="card-body">
                <h5 class="card-title mb-3"><i class="fa-solid fa-bolt text-coelho-verde"></i> Ações Rápidas</h5>
                <div class="d-grid gap-2">
                    <form asp-action="AtualizarExtratores" method="post" class="d-grid gap-2 mb-2">
                        <button type="submit" class="btn btn-success" onclick="this.innerHTML='<span class=\'spinner-border spinner-border-sm\' role=\'status\' aria-hidden=\'true\'></span> Atualizando...'; this.disabled=true; this.form.submit();">
                            <i class="fa-solid fa-rotate"></i> Atualizar Extratores (Notícias e Tabelas)
                        </button>
                    </form>
                    <a asp-controller="Posts" asp-action="Create" class="btn btn-coelho-primary"><i class="fa-solid fa-plus"></i> Novo Artigo</a>
                    <a asp-controller="ProdutosLoja" asp-action="Create" class="btn btn-outline-secondary"><i class="fa-solid fa-plus"></i> Novo Produto (Loja)</a>
                    <a asp-controller="BannersAfiliados" asp-action="Create" class="btn btn-outline-secondary"><i class="fa-solid fa-plus"></i> Novo Banner</a>
                    <a asp-controller="Categorias" asp-action="Create" class="btn btn-outline-secondary"><i class="fa-solid fa-plus"></i> Nova Categoria</a>
                </div>
            </div>
        </div>
    </div>
</div>
