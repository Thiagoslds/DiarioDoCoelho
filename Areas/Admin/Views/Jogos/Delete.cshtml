@model Jogo

@{
    ViewData["Title"] = "Excluir Jogo";
}

<h1>Excluir Jogo</h1>

<h3>Tem certeza que deseja excluir este jogo?</h3>
<div>
    <dl class="row">
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.DataHora)</dt>
        <dd class="col-sm-10">@Model.DataHora.ToString("dd/MM/yyyy HH:mm")</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Adversario)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Adversario)</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Excluir</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>
