@model IEnumerable<Jogo>

@{
    ViewData["Title"] = "Jogos";
}

<h1>Jogos</h1>

<p>
    <a asp-action="Create" class="btn btn-danger">Novo Jogo</a>
</p>
<table class="table table-striped">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.DataHora)</th>
            <th>@Html.DisplayNameFor(model => model.Adversario)</th>
            <th>@Html.DisplayNameFor(model => model.Campeonato)</th>
            <th>Placar</th>
            <th>@Html.DisplayNameFor(model => model.Mandante)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model)
{
        <tr>
            <td>@item.DataHora.ToString("dd/MM/yyyy HH:mm")</td>
            <td>@Html.DisplayFor(modelItem => item.Adversario)</td>
            <td>@Html.DisplayFor(modelItem => item.Campeonato)</td>
            <td>@(item.PlacarAmerica is not null && item.PlacarAdversario is not null ? $"{item.PlacarAmerica} x {item.PlacarAdversario}" : "-")</td>
            <td>@(item.Mandante ? "Sim" : "Não")</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Editar</a>
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Detalhes</a>
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Excluir</a>
            </td>
        </tr>
}
    </tbody>
</table>
