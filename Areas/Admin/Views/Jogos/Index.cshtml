@model IEnumerable<Jogo>

@{
    ViewData["Title"] = "Jogos";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0"><i class="fa-solid fa-futbol text-coelho-verde"></i> Jogos</h1>
    <a asp-action="Create" class="btn btn-coelho-primary"><i class="fa-solid fa-plus"></i> Novo Jogo</a>
</div>

<div class="card admin-card">
    <div class="card-body">
        <table class="table table-striped admin-table align-middle mb-0">
            <thead>
                <tr>
                    <th>@Html.DisplayNameFor(model => model.DataHora)</th>
                    <th>@Html.DisplayNameFor(model => model.Adversario)</th>
                    <th>@Html.DisplayNameFor(model => model.Campeonato)</th>
                    <th>Placar</th>
                    <th>@Html.DisplayNameFor(model => model.Mandante)</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
        @foreach (var item in Model)
        {
                <tr>
                    <td>@item.DataHora.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@Html.DisplayFor(modelItem => item.Adversario)</td>
                    <td>@Html.DisplayFor(modelItem => item.Campeonato)</td>
                    <td>@(item.PlacarAmerica is not null && item.PlacarAdversario is not null ? $"{item.PlacarAmerica} x {item.PlacarAdversario}" : "-")</td>
                    <td>@(item.Mandante ? "Sim" : "Não")</td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary" title="Editar"><i class="fa-solid fa-pen"></i></a>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary" title="Detalhes"><i class="fa-solid fa-eye"></i></a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-coelho-outline-danger" title="Excluir"><i class="fa-solid fa-trash"></i></a>
                    </td>
                </tr>
        }
            </tbody>
        </table>
    </div>
</div>
