@model Jogo

@{
    ViewData["Title"] = "Detalhes do Jogo";
}

<h1>Detalhes</h1>

<div>
    <dl class="row">
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Categoria)</dt>
        <dd class="col-sm-10">@Model.Categoria</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.DataHora)</dt>
        <dd class="col-sm-10">@Model.DataHora.ToString("dd/MM/yyyy HH:mm")</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Adversario)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Adversario)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Campeonato)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Campeonato)</dd>

        <dt class="col-sm-2">Placar</dt>
        <dd class="col-sm-10">@(Model.PlacarAmerica is not null && Model.PlacarAdversario is not null ? $"{Model.PlacarAmerica} x {Model.PlacarAdversario}" : "-")</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Mandante)</dt>
        <dd class="col-sm-10">@(Model.Mandante ? "Sim" : "Não")</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.LinkTabela)</dt>
        <dd class="col-sm-10">@(string.IsNullOrEmpty(Model.LinkTabela) ? "-" : Model.LinkTabela)</dd>
    </dl>
</div>
<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Editar</a>
<a asp-action="Index" class="btn btn-secondary">Voltar à lista</a>
