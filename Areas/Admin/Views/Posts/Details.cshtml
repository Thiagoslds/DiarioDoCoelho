@model Post

@{
    ViewData["Title"] = "Detalhes da Notícia";
}

<h1>Detalhes</h1>

<div>
    <dl class="row">
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Titulo)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Titulo)</dd>

        <dt class="col-sm-2">Categoria</dt>
        <dd class="col-sm-10">@Model.Categoria?.Nome</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Resumo)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Resumo)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Slug)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Slug)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.DataPublicacao)</dt>
        <dd class="col-sm-10">@Model.DataPublicacao.ToString("dd/MM/yyyy HH:mm")</dd>
    </dl>
</div>
<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Editar</a>
<a asp-controller="Post" asp-action="Ler" asp-route-slug="@Model.Slug" asp-area="" target="_blank" class="btn btn-outline-primary">Ver no site</a>
<a asp-action="Index" class="btn btn-secondary">Voltar à lista</a>
