@model Post

@{
    ViewData["Title"] = "Nova Notícia";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.snow.css" />

<h1 class="mb-4"><i class="fa-solid fa-newspaper text-coelho-verde"></i> Nova Notícia</h1>

<div class="card admin-card">
    <div class="card-body">
        <form asp-action="Create" id="form-post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="Titulo" class="form-label"></label>
                <input asp-for="Titulo" class="form-control" />
                <span asp-validation-for="Titulo" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Resumo" class="form-label"></label>
                <textarea asp-for="Resumo" class="form-control" rows="2"></textarea>
                <span asp-validation-for="Resumo" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Conteudo" class="form-label"></label>
                <div id="quill-editor"></div>
                <textarea asp-for="Conteudo" id="editor-conteudo" class="d-none"></textarea>
                <span asp-validation-for="Conteudo" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Slug" class="form-label"></label>
                <input asp-for="Slug" class="form-control" placeholder="ex: america-vence-o-jogo" />
                <span asp-validation-for="Slug" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="CategoriaId" class="form-label"></label>
                <select asp-for="CategoriaId" class="form-select" asp-items="ViewBag.CategoriaId"></select>
                <span asp-validation-for="CategoriaId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DataPublicacao" class="form-label"></label>
                <input asp-for="DataPublicacao" class="form-control" />
                <span asp-validation-for="DataPublicacao" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ImagemCapa" class="form-label"></label>
                <input asp-for="ImagemCapa" class="form-control" />
                <span asp-validation-for="ImagemCapa" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="FonteNoticiaUrl" class="form-label"></label>
                <input asp-for="FonteNoticiaUrl" class="form-control" />
                <span asp-validation-for="FonteNoticiaUrl" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="VideoEmbed" class="form-label"></label>
                <textarea asp-for="VideoEmbed" class="form-control" rows="3" placeholder="&lt;iframe ...&gt;&lt;/iframe&gt;"></textarea>
                <span asp-validation-for="VideoEmbed" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ProdutoAfiliadoUrl" class="form-label"></label>
                <input asp-for="ProdutoAfiliadoUrl" class="form-control" />
                <span asp-validation-for="ProdutoAfiliadoUrl" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-coelho-primary"><i class="fa-solid fa-floppy-disk"></i> Salvar</button>
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.js"></script>
    <script>
        const quill = new Quill('#quill-editor', {
            theme: 'snow',
            placeholder: 'Escreva o conteúdo da notícia...'
        });

        const conteudoTextarea = document.getElementById('editor-conteudo');
        quill.root.innerHTML = conteudoTextarea.value;

        document.getElementById('form-post').addEventListener('submit', function () {
            conteudoTextarea.value = quill.root.innerHTML;
        });
    </script>
}
