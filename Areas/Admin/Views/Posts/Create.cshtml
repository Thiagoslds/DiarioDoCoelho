@model Post

@{
    ViewData["Title"] = "Nova Notícia";
}

<h1>Nova Notícia</h1>

<form asp-action="Create">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="Titulo" class="form-label"></label>
        <input asp-for="Titulo" class="form-control" />
        <span asp-validation-for="Titulo" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Resumo" class="form-label"></label>
        <textarea asp-for="Resumo" class="form-control" rows="2"></textarea>
        <span asp-validation-for="Resumo" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Conteudo" class="form-label"></label>
        <!-- TODO: Substituir por editor WYSIWYG (ex: TinyMCE, Quill ou CKEditor) futuramente -->
        <textarea asp-for="Conteudo" id="editor-conteudo" class="form-control" rows="12"></textarea>
        <span asp-validation-for="Conteudo" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Slug" class="form-label"></label>
        <input asp-for="Slug" class="form-control" placeholder="ex: america-vence-o-jogo" />
        <span asp-validation-for="Slug" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="CategoriaId" class="form-label"></label>
        <select asp-for="CategoriaId" class="form-select" asp-items="ViewBag.CategoriaId"></select>
        <span asp-validation-for="CategoriaId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="DataPublicacao" class="form-label"></label>
        <input asp-for="DataPublicacao" class="form-control" />
        <span asp-validation-for="DataPublicacao" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="ImagemCapa" class="form-label"></label>
        <input asp-for="ImagemCapa" class="form-control" />
        <span asp-validation-for="ImagemCapa" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="FonteNoticiaUrl" class="form-label"></label>
        <input asp-for="FonteNoticiaUrl" class="form-control" />
        <span asp-validation-for="FonteNoticiaUrl" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="VideoEmbed" class="form-label"></label>
        <textarea asp-for="VideoEmbed" class="form-control" rows="3" placeholder="&lt;iframe ...&gt;&lt;/iframe&gt;"></textarea>
        <span asp-validation-for="VideoEmbed" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="ProdutoAfiliadoUrl" class="form-label"></label>
        <input asp-for="ProdutoAfiliadoUrl" class="form-control" />
        <span asp-validation-for="ProdutoAfiliadoUrl" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-danger">Salvar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
