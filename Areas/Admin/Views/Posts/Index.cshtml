@model IEnumerable<Post>

@{
    ViewData["Title"] = "Notícias";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0"><i class="fa-solid fa-newspaper text-coelho-verde"></i> Notícias</h1>
    <a asp-action="Create" class="btn btn-coelho-primary">
        <i class="fa-solid fa-plus"></i> Nova Notícia
    </a>
</div>

<div class="card admin-card">
    <div class="card-body">
        <table class="table table-striped admin-table align-middle mb-0">
            <thead>
                <tr>
                    <th>@Html.DisplayNameFor(model => model.Titulo)</th>
                    <th>Categoria</th>
                    <th>@Html.DisplayNameFor(model => model.DataPublicacao)</th>
                    <th>@Html.DisplayNameFor(model => model.Slug)</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
        @foreach (var item in Model)
        {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.Titulo)</td>
                    <td>@item.Categoria?.Nome</td>
                    <td>@item.DataPublicacao.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@Html.DisplayFor(modelItem => item.Slug)</td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary" title="Editar"><i class="fa-solid fa-pen"></i></a>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary" title="Detalhes"><i class="fa-solid fa-eye"></i></a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-coelho-outline-danger" title="Excluir"><i class="fa-solid fa-trash"></i></a>
                    </td>
                </tr>
        }
            </tbody>
        </table>
    </div>
</div>
