@model BannerAfiliado

@{
    ViewData["Title"] = "Detalhes do Banner";
}

<h1>Detalhes</h1>

<div>
    <dl class="row">
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Titulo)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Titulo)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.ImagemUrl)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.ImagemUrl)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.LinkAfiliado)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.LinkAfiliado)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Posicao)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Posicao)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Ativo)</dt>
        <dd class="col-sm-10">@(Model.Ativo ? "Sim" : "Não")</dd>
    </dl>
</div>
<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Editar</a>
<a asp-action="Index" class="btn btn-secondary">Voltar à lista</a>
