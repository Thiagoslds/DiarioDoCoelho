@{
  ViewData["Title"] = "Contato";
}

<partial name="_Breadcrumb" model='new List<DiarioDoCoelho.ViewModels.BreadcrumbItem> { new("Contato") }' />

<div class="card coelho-card">
  <div class="card-body">
    <h1 class="text-coelho-verde mb-4">@ViewData["Title"]</h1>

    <p>Quer enviar uma sugestão de pauta, corrigir alguma informação ou falar sobre parcerias? Entre em contato com a gente!</p>

    <ul class="list-unstyled mt-4">
      <li class="mb-3">
        <i class="fa-solid fa-envelope"></i> <strong>E-mail:</strong>
        <a href="mailto:diario.coelho.afc@gmail.com">diario.coelho.afc@gmail.com</a>
      </li>
      <li class="mb-3">
        <i class="fa-brands fa-instagram"></i> <strong>Instagram:</strong>
        <a href="https://instagram.com/diariocoelho" target="_blank" rel="noopener">@@diariocoelho</a>
      </li>
      <li class="mb-3">
        <i class="fa-brands fa-twitter"></i> <strong>X (Twitter):</strong>
        <a href="https://x.com/DiarioDoCoelho" target="_blank" rel="noopener">@@DiarioDoCoelho</a>
      </li>
    </ul>

    <p class="text-muted small mt-4">O Diário do Coelho é um veículo de imprensa independente, sem vínculo oficial com o América Futebol Clube.</p>
  </div>
</div>
