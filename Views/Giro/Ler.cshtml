@model DiarioDoCoelho.Models.Post
@using DiarioDoCoelho.ViewModels

@{
    ViewData["Title"] = Model.Titulo;
    var produtos = ViewBag.ProdutosLoja as List<ProdutoAfiliadoViewModel> ?? new List<ProdutoAfiliadoViewModel>();
    var nomeFonte = Model.FonteNoticiaUrl is not null
        ? new Uri(Model.FonteNoticiaUrl).Host.Replace("www.", string.Empty)
        : "site parceiro";
}

<partial name="_Breadcrumb" model='new List<DiarioDoCoelho.ViewModels.BreadcrumbItem> { new("Notícias", Url.Action("Index", "Post")), new(Model.Titulo) }' />

<partial name="_AdSenseSlot" view-data='new ViewDataDictionary(ViewData) { ["Tamanho"] = "Banner (728x90)" }' />

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <span class="coelho-badge mb-2" data-cor="verde">@Model.Categoria?.Nome</span>
        <h1 class="mb-3">@Model.Titulo</h1>
        <p class="lead text-muted">@Model.Resumo</p>

        @if (!string.IsNullOrEmpty(Model.ImagemCapa))
        {
            <img src="@Model.ImagemCapa" alt="@Model.Titulo" class="img-fluid rounded mb-4" />
        }

        <div class="text-center my-4">
            <a href="@Model.FonteNoticiaUrl" target="_blank" rel="nofollow noopener" class="btn btn-coelho-primary btn-lg px-4 py-3">
                <i class="fa-solid fa-arrow-up-right-from-square"></i> Continuar lendo no site da @nomeFonte
            </a>
        </div>

        <hr class="my-5" />

        <h4 class="text-coelho-verde mb-3"><i class="fa-solid fa-shirt"></i> Vitrine da Loja do Coelho</h4>
        <div class="row row-cols-2 row-cols-md-4 g-3 mb-4">
            @foreach (var produto in produtos)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm">
                        <img src="@produto.ImagemUrl" class="card-img-top" alt="@produto.Nome" style="object-fit:cover; height:140px;" />
                        <div class="card-body d-flex flex-column p-2">
                            <p class="card-text small mb-2">@produto.Nome</p>
                            <a href="@produto.LinkAfiliado" target="_blank" rel="nofollow sponsored noopener" class="btn btn-sm btn-coelho-outline mt-auto">Ver oferta</a>
                        </div>
                    </div>
                </div>
            }
        </div>

        <a asp-controller="Home" asp-action="Index" class="d-inline-block mb-4 small text-coelho-verde">&larr; Voltar para a Home</a>
    </div>
</div>

<partial name="_AdSenseSlot" view-data='new ViewDataDictionary(ViewData) { ["Tamanho"] = "Banner (728x90)" }' />
