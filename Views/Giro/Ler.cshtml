@model DiarioDoCoelho.ViewModels.GiroLerViewModel

@{
  ViewData["Title"] = Model.Titulo;
  var nomeFonte = !string.IsNullOrEmpty(Model.FonteNoticiaUrl) && Uri.TryCreate(Model.FonteNoticiaUrl, UriKind.Absolute, out var uriFonte)
      ? uriFonte.Host.Replace("www.", string.Empty)
      : (Model.CategoriaNome ?? "site parceiro");
}

<partial name="_Breadcrumb" model='new List<DiarioDoCoelho.ViewModels.BreadcrumbItem> { new("Notícias", Url.Action("Index", "Post")), new(Model.Titulo) }' />

<partial name="_AdSenseSlot" view-data='new ViewDataDictionary(ViewData) { ["Tamanho"] = "Banner (728x90)" }' />

<div class="row justify-content-center">
  <div class="col-12 col-lg-9">
    <div class="card coelho-card">
      <div class="row g-0 align-items-center">
        @if (!string.IsNullOrEmpty(Model.ImagemCapa))
        {
          <div class="col-12 col-md-5">
            <img src="@Model.ImagemCapa" alt="@Model.Titulo" class="img-fluid rounded-start" style="width:100%; height:100%; object-fit:cover; max-height:320px;" onerror="this.src='/img/placeholder-america.png'" />
          </div>
        }
        <div class="@(!string.IsNullOrEmpty(Model.ImagemCapa) ? "col-12 col-md-7" : "col-12")">
          <div class="card-body">
            <h1 class="mb-0 fs-4">@Model.Titulo</h1>
          </div>
        </div>
      </div>
    </div>

    @if (Model.ProdutosLoja.Any())
    {
      <h4 class="text-coelho-verde mt-5 mb-3"><i class="fa-solid fa-shirt"></i> Vitrine da Loja do Coelho</h4>
      <div class="row row-cols-2 row-cols-md-3 g-3 mb-4">
        @foreach (var produto in Model.ProdutosLoja.Take(3))
        {
          <div class="col">
            <div class="card h-100 shadow-sm">
              <img src="@produto.ImagemUrl" class="card-img-top" alt="@produto.Nome" style="object-fit:cover; height:140px;" />
              <div class="card-body d-flex flex-column p-2">
                <p class="card-text small mb-2">@produto.Nome</p>
                <a href="@produto.LinkAfiliado" target="_blank" rel="nofollow sponsored noopener" class="btn btn-sm btn-coelho-primary mt-auto">Ver oferta</a>
              </div>
            </div>
          </div>
        }
      </div>
    }

    <div class="text-center my-4">
      <a href="@Model.FonteNoticiaUrl" class="btn btn-coelho-primary btn-lg px-4 py-3">
        <i class="fa-solid fa-arrow-up-right-from-square"></i> Continuar lendo no site de @nomeFonte
      </a>
    </div>

    <a asp-controller="Home" asp-action="Index" class="d-inline-block mb-4 small text-coelho-verde">&larr; Voltar para a Home</a>
  </div>
</div>

