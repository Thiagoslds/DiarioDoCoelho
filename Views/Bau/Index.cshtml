@model List<Post>

@{
    ViewData["Title"] = "Baú do Coelho";
}

<partial name="_Breadcrumb" model='new List<DiarioDoCoelho.ViewModels.BreadcrumbItem> { new("Baú do Coelho") }' />

<h1 class="mb-1 text-coelho-verde"><i class="fa-solid fa-box-archive"></i> Baú do Coelho</h1>
<p class="text-muted mb-4">Ídolos, jogos épicos e a história do América Futebol Clube através dos tempos.</p>

<partial name="_AdSenseSlot" view-data='new ViewDataDictionary(ViewData) { ["Tamanho"] = "Banner (728x90)" }' />

<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
    @foreach (var post in Model)
    {
        <div class="col">
            <div class="card coelho-card h-100">
                @if (!string.IsNullOrEmpty(post.ImagemCapa))
                {
                    <img src="@post.ImagemCapa" alt="@post.Titulo" class="card-img-top" style="object-fit:cover; height:180px;" />
                }
                <div class="card-body d-flex flex-column">
                    <span class="coelho-badge mb-2" data-cor="retro">@post.Categoria?.Nome</span>
                    <h5 class="card-title">
                        <a asp-controller="Post" asp-action="Ler" asp-route-slug="@post.Slug" class="text-decoration-none">@post.Titulo</a>
                    </h5>
                    <p class="card-text text-muted small flex-grow-1">@post.Resumo</p>
                    @if (!string.IsNullOrEmpty(post.ProdutoAfiliadoUrl))
                    {
                        <a href="@post.ProdutoAfiliadoUrl" target="_blank" rel="nofollow sponsored noopener" class="btn btn-sm btn-coelho-outline mt-2">
                            <i class="fa-solid fa-shirt"></i> Ver camisa retrô da época
                        </a>
                    }
                </div>
            </div>
        </div>
    }
</div>

@if (!Model.Any())
{
    <p class="text-muted">Nenhuma história publicada ainda.</p>
}

<partial name="_AdSenseSlot" view-data='new ViewDataDictionary(ViewData) { ["Tamanho"] = "Banner (728x90)" }' />
