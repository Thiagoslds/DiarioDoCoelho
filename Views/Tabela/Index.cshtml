@model DiarioDoCoelho.ViewModels.TabelaIndexViewModel

@{
  ViewData["Title"] = "Classificação";
}

<div class="container mt-4 mb-5">
  <div class="row">

    <!-- COLUNA DA TABELA (Ocupa 8 espaços no PC, 12 no celular) -->
    <div class="col-12 col-lg-8">
      <h2 class="mb-4 text-coelho-verde"><i class="fa-solid fa-list-ol me-2"></i>Classificação</h2>

      <div class="table-responsive shadow-sm rounded bg-white border">
        <table class="tabela-classificacao w-100">
          <thead>
            <tr>
              <th style="width: 50px;">POS</th>
              <th style="text-align: left;">TIME</th>
              <th>P</th>
              <th>J</th>
              <th>V</th>
              <th>E</th>
              <th>D</th>
              <th>GP</th>
              <th>GC</th>
              <th>SG</th>
              <th>%</th>
              <th>ÚLTIMOS JOGOS</th>
            </tr>
          </thead>
          <tbody>
            @foreach (var item in Model.Classificacao)
            {
              var nomeTime = item.Time.NomePopular.Replace("América Mineiro", "América");
              var classeDestaque = (item.Time.TimeId == 59897 || nomeTime.Contains("América")) ? "time-destaque" : "";

              <tr class="@classeDestaque">
                <td class="col-posicao">@item.Posicao</td>
                <td class="col-time">
                  <img src="@item.Time.Escudo" alt="Escudo @nomeTime" class="escudo-time" loading="lazy" />
                  <span class="text-truncate" style="max-width: 120px;" title="@nomeTime">@nomeTime</span>
                </td>
                <td style="font-weight: bold;">@item.Pontos</td>
                <td>@item.Jogos</td>
                <td>@item.Vitorias</td>
                <td>@item.Empates</td>
                <td>@item.Derrotas</td>
                <td>@item.GolsPro</td>
                <td>@item.GolsContra</td>
                <td>@item.SaldoGols</td>
                <td>@item.Aproveitamento</td>
                <td>
                  <div class="forma-container">
                    @if (item.UltimosJogos != null)
                    {
                      @foreach (var forma in item.UltimosJogos)
                      {
                        <span class="forma-bolinha forma-@(forma.ToLower())" title="@forma.ToUpper()"></span>
                      }
                    }
                  </div>
                </td>
              </tr>
            }
          </tbody>
        </table>
      </div>
    </div>

    <!-- COLUNA LATERAL (Ocupa 4 espaços no PC, 12 no celular) -->
    <div class="col-12 col-lg-4 mt-5 mt-lg-0">

      <!-- BLOCO 1: PRÓXIMOS JOGOS -->
      <h2 class="mb-4 text-coelho-verde"><i class="fa-solid fa-calendar-days me-2"></i>Na Agenda</h2>

      @if (Model.ProximosJogos.Any())
      {
        <div class="card shadow-sm border-0 rounded-3 mb-5">
          <ul class="list-group list-group-flush rounded-3">
            @foreach (var jogo in Model.ProximosJogos)
            {
              <li class="list-group-item text-center py-4 bg-light border-bottom">
                <div class="small text-muted mb-1 fw-semibold">
                  <i class="fa-regular fa-clock me-1"></i> @jogo.DataHora
                </div>
                <div class="small text-muted mb-3" style="font-size: 0.75rem;">@jogo.Campeonato</div>

                <div class="d-flex justify-content-center align-items-center gap-2">
                  <div class="text-end" style="flex: 1;">
                    <span class="fw-bold d-block mb-2 small text-truncate" title="@jogo.Mandante">@jogo.Mandante.Replace("América Mineiro", "América")</span>
                    <img src="@jogo.EscudoMandante" onerror="this.onerror=null; this.src='@jogo.EscudoFallbackMandante';" width="42" height="42" style="object-fit: contain;">
                  </div>

                  <div class="text-muted fw-bold mx-2">X</div>

                  <div class="text-start" style="flex: 1;">
                    <span class="fw-bold d-block mb-2 small text-truncate" title="@jogo.Visitante">@jogo.Visitante.Replace("América Mineiro", "América")</span>
                    <img src="@jogo.EscudoVisitante" onerror="this.onerror=null; this.src='@jogo.EscudoFallbackVisitante';" width="42" height="42" style="object-fit: contain;">
                  </div>
                </div>
              </li>
            }
          </ul>
        </div>
      }
      else
      {
        <div class="alert alert-light border shadow-sm text-center py-4 mb-5" role="alert">
          <i class="fa-solid fa-bed text-muted fs-3 mb-3 d-block"></i>
          Nenhuma partida agendada para o Coelho no momento.
        </div>
      }

      <!-- BLOCO 2: ÚLTIMOS RESULTADOS -->
      <h2 class="mb-4 text-coelho-verde"><i class="fa-solid fa-clock-rotate-left me-2"></i>Últimos Resultados</h2>

      @if (Model.JogosAnteriores.Any())
      {
        <div class="card shadow-sm border-0 rounded-3">
          <ul class="list-group list-group-flush rounded-3">
            @foreach (var jogo in Model.JogosAnteriores)
            {
              <li class="list-group-item text-center py-4 border-bottom">
                <div class="small text-muted mb-1 fw-semibold">
                  <i class="fa-regular fa-calendar-check me-1"></i> @jogo.DataHora
                </div>
                <div class="small text-muted mb-3" style="font-size: 0.75rem;">@jogo.Campeonato</div>

                <div class="d-flex justify-content-center align-items-center gap-2">
                  <div class="text-end" style="flex: 1;">
                    <span class="fw-bold d-block mb-2 small text-truncate" title="@jogo.Mandante">@jogo.Mandante.Replace("América Mineiro", "América")</span>
                    <img src="@jogo.EscudoMandante" onerror="this.onerror=null; this.src='@jogo.EscudoFallbackMandante';" width="38" height="38" style="object-fit: contain;">
                  </div>

                  <div class="fw-bold fs-4 px-2">@jogo.PlacarMandante</div>
                  <div class="text-muted fw-bold">X</div>
                  <div class="fw-bold fs-4 px-2">@jogo.PlacarVisitante</div>

                  <div class="text-start" style="flex: 1;">
                    <span class="fw-bold d-block mb-2 small text-truncate" title="@jogo.Visitante">@jogo.Visitante.Replace("América Mineiro", "América")</span>
                    <img src="@jogo.EscudoVisitante" onerror="this.onerror=null; this.src='@jogo.EscudoFallbackVisitante';" width="38" height="38" style="object-fit: contain;">
                  </div>
                </div>
              </li>
            }
          </ul>
        </div>
      }
    </div>

  </div>
</div>